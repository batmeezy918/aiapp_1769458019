{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verification Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["verification_id", "subject_object_ids", "gate_id", "verifier_version", "result", "evidence_sha256", "timestamp_utc"],
  "properties": {
    "verification_id": {"type": "string", "pattern": "^ver-[a-f0-9]{16,64}$"},
    "subject_object_ids": {"type": "array", "items": {"type": "string"}},
    "gate_id": {"type": "string", "minLength": 1},
    "verifier_version": {"type": "string", "minLength": 1},
    "result": {"enum": ["PASS", "FAIL", "INCONCLUSIVE"]},
    "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "details": {"type": "string"}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deterministic Transformation Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "transformation_id",
    "parent_object_ids",
    "input_sha256",
    "operation_id",
    "operation_version",
    "toolchain_id",
    "parameters_sha256",
    "output_sha256",
    "timestamp_utc",
    "actor",
    "result",
    "verification_ids"
  ],
  "properties": {
    "transformation_id": {"type": "string", "pattern": "^tr-[a-f0-9]{16,64}$"},
    "parent_object_ids": {"type": "array", "items": {"type": "string"}},
    "input_sha256": {"type": "array", "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "operation_id": {"type": "string", "minLength": 1},
    "operation_version": {"type": "string", "minLength": 1},
    "toolchain_id": {"type": "string", "minLength": 1},
    "parameters_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "output_sha256": {"type": "array", "items": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "actor": {"type": "string", "minLength": 1},
    "result": {"enum": ["PROPOSED", "CREATED", "VERIFIED", "REJECTED"]},
    "verification_ids": {"type": "array", "items": {"type": "string"}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Verification Orchestration Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "orchestration_id",
    "verification_object_id",
    "command",
    "input_sha256",
    "policy_version",
    "executor_version",
    "attempt",
    "state",
    "payment_decision"
  ],
  "properties": {
    "orchestration_id": {"type": "string", "pattern": "^orch-[a-f0-9]{16,64}$"},
    "verification_object_id": {"type": "string", "minLength": 1},
    "command": {
      "enum": [
        "ADMIT",
        "NORMALIZE",
        "QUOTIENT",
        "INSTANTIATE",
        "EXECUTE",
        "COMPARE",
        "FALSIFY",
        "REPLAY",
        "CERTIFY",
        "EXPORT"
      ]
    },
    "input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_version": {"type": "string", "minLength": 1},
    "executor_version": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "state": {
      "enum": [
        "ADMITTED",
        "NORMALIZED",
        "QUOTIENTED",
        "INSTANTIATED",
        "QUEUED",
        "EXECUTING",
        "COMPARED",
        "FALSIFIED",
        "REPLAYED",
        "CERTIFIED",
        "REJECTED"
      ]
    },
    "payment_decision": {"const": "NOT_EVALUATED"},
    "source_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "fixture_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "execution_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reference_execution_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "equivalence_result": {"enum": ["EQUIVALENT", "DIVERGENT", "NOT_EVALUATED"]},
    "replay_result": {"enum": ["EXACT", "DIVERGENT", "NOT_EVALUATED"]},
    "evidence_strength": {"enum": ["NONE", "CANDIDATE", "EMPIRICAL", "FORMAL_PARTIAL", "FORMAL", "NORMATIVE"]},
    "claim_strength": {"enum": ["NONE", "CANDIDATE", "EMPIRICAL", "FORMAL_PARTIAL", "FORMAL", "NORMATIVE"]},
    "event_ids": {"type": "array", "items": {"type": "string"}},
    "artifact_refs": {"type": "array", "items": {"type": "string"}},
    "created_at_utc": {"type": "string", "format": "date-time"}
  }
}
